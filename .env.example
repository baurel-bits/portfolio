# Web3Forms — formulaire de contact.
# Créer une clé : https://web3forms.com/ (voir README, section « Formulaire de contact »).
# Laisser vide tant que la clé n'est pas créée : le formulaire affiche alors
# un renvoi vers l'adresse email au lieu d'un envoi qui échouerait.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# URL publique du site, sans barre oblique finale.
# Utilisée pour les balises canonical, Open Graph et le sitemap.
# Remplacer par le domaine réel avant mise en ligne.
NEXT_PUBLIC_SITE_URL=https://votre-domaine.example
